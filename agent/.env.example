# Copy to agent/.env (ignored by git) and fill in. Never commit the key.
OPS_AGENT_MODE=llm
OPS_AGENT_LLM_BASE_URL=https://api.example.com/v1
OPS_AGENT_LLM_MODEL=model-name
OPS_AGENT_LLM_API_KEY=

# The chat's quick calls (routing, summaries): for a reasoning model, turn its thinking off there, e.g. for DeepSeek
# OPS_AGENT_CHAT_FAST_EXTRA_BODY={"thinking":{"type":"disabled"}}
# or use a smaller model: OPS_AGENT_CHAT_FAST_MODEL=
