[
  {
    "rule_id": "ssh-brute-force",
    "version": 1,
    "enabled": true,
    "name": "SSH brute force",
    "match": {"event_types": ["ssh_login_failed", "ssh_invalid_user"], "source_types": ["linux"]},
    "group_by": ["host", "fields.src_ip"],
    "window": "PT5M",
    "threshold": 5,
    "severity": "medium",
    "suppress_for": "PT15M",
    "summary_template": "{count} failed SSH logins from {fields.src_ip} on {host} within {window}"
  },
  {
    "rule_id": "mysql-connection-refused",
    "version": 1,
    "enabled": true,
    "name": "MySQL refuses connections",
    "match": {"event_types": ["mysql_connection_refused"]},
    "group_by": ["host"],
    "window": "PT1M",
    "threshold": 1,
    "severity": "high",
    "suppress_for": "PT10M",
    "summary_template": "MySQL on {host} refused connections ({count} within {window})"
  },
  {
    "rule_id": "mysql-too-many-connections",
    "version": 1,
    "enabled": true,
    "name": "MySQL connection limit reached",
    "match": {"event_types": ["mysql_too_many_connections"]},
    "group_by": ["host"],
    "window": "PT1M",
    "threshold": 1,
    "severity": "high",
    "suppress_for": "PT10M",
    "summary_template": "MySQL on {host} reached its connection limit"
  },
  {
    "rule_id": "mysql-slow-query-burst",
    "version": 1,
    "enabled": true,
    "name": "MySQL slow query burst",
    "match": {"event_types": ["mysql_slow_query"]},
    "group_by": ["host"],
    "window": "PT5M",
    "threshold": 3,
    "severity": "low",
    "suppress_for": "PT15M",
    "summary_template": "{count} slow queries on {host} within {window}"
  },
  {
    "rule_id": "app-db-connection-errors",
    "version": 1,
    "enabled": true,
    "name": "Application cannot reach its database",
    "match": {"event_types": ["app_db_connection_error"]},
    "group_by": ["service", "host"],
    "window": "PT5M",
    "threshold": 2,
    "severity": "medium",
    "suppress_for": "PT10M",
    "summary_template": "{service} on {host} failed to reach its database {count} times within {window}"
  },
  {
    "rule_id": "nginx-5xx-burst",
    "version": 1,
    "enabled": true,
    "name": "Nginx 5xx burst",
    "match": {"event_types": ["http_server_error"]},
    "group_by": ["host"],
    "window": "PT5M",
    "threshold": 5,
    "severity": "medium",
    "suppress_for": "PT10M",
    "summary_template": "{count} HTTP 5xx responses on {host} within {window}"
  },
  {
    "rule_id": "container-oom-killed",
    "version": 1,
    "enabled": true,
    "name": "Container killed for memory",
    "match": {"event_types": ["container_oom_killed"]},
    "group_by": ["host", "fields.container"],
    "window": "PT1M",
    "threshold": 1,
    "severity": "high",
    "suppress_for": "PT15M",
    "summary_template": "Container {fields.container} on {host} was OOM-killed"
  },
  {
    "rule_id": "container-restart-loop",
    "version": 1,
    "enabled": true,
    "name": "Container restart loop",
    "match": {"event_types": ["container_restarted"]},
    "group_by": ["host", "fields.container"],
    "window": "PT15M",
    "threshold": 3,
    "severity": "medium",
    "suppress_for": "PT30M",
    "summary_template": "Container {fields.container} on {host} restarted {count} times within {window}"
  },
  {
    "rule_id": "kernel-oom",
    "version": 1,
    "enabled": true,
    "name": "Kernel OOM killer",
    "match": {"event_types": ["kernel_oom"]},
    "group_by": ["host"],
    "window": "PT1M",
    "threshold": 1,
    "severity": "high",
    "suppress_for": "PT15M",
    "summary_template": "Kernel OOM killer ran on {host}"
  },
  {
    "rule_id": "disk-usage-high",
    "version": 1,
    "enabled": true,
    "name": "Disk usage warning or critical",
    "match": {"event_types": ["disk_usage"], "min_severity": "medium"},
    "group_by": ["host", "fields.mount"],
    "window": "PT5M",
    "threshold": 1,
    "severity": "medium",
    "suppress_for": "PT1H",
    "summary_template": "Disk {fields.mount} on {host} is at {fields.usage_percent}%"
  },
  {
    "rule_id": "shop-database-unavailable",
    "version": 1,
    "enabled": true,
    "name": "Shop service cannot use its database",
    "match": {"event_types": ["database_unavailable"]},
    "group_by": ["service"],
    "window": "PT1M",
    "threshold": 3,
    "severity": "high",
    "suppress_for": "PT10M",
    "summary_template": "{service} answered {count} requests with DATABASE_UNAVAILABLE within {window}"
  },
  {
    "rule_id": "shop-dependency-call-failures",
    "version": 1,
    "enabled": true,
    "name": "Shop service calls to another service failing",
    "match": {"event_types": ["dependency_call_failed"]},
    "group_by": ["service", "fields.dependency"],
    "window": "PT1M",
    "threshold": 10,
    "severity": "medium",
    "suppress_for": "PT10M",
    "summary_template": "{count} failed calls from {service} to {fields.dependency} within {window}"
  },
  {
    "rule_id": "shop-unhandled-errors",
    "version": 1,
    "enabled": true,
    "name": "Unhandled error in a shop service",
    "match": {"event_types": ["unhandled_error"]},
    "group_by": ["service"],
    "window": "PT5M",
    "threshold": 1,
    "severity": "high",
    "suppress_for": "PT15M",
    "summary_template": "{count} unhandled errors in {service} within {window}"
  },
  {
    "rule_id": "shop-inventory-task-failed",
    "version": 1,
    "enabled": true,
    "name": "Stock settlement refused, needs manual review",
    "match": {"event_types": ["inventory_task_failed"]},
    "group_by": ["service"],
    "window": "PT5M",
    "threshold": 1,
    "severity": "high",
    "suppress_for": "PT30M",
    "summary_template": "Inventory refused {count} settlements within {window}; the stock of those orders needs manual review"
  },
  {
    "rule_id": "shop-recovery-failing",
    "version": 1,
    "enabled": true,
    "name": "Shop background recovery keeps failing",
    "match": {"event_types": ["recovery_step_failed"]},
    "group_by": ["service", "fields.step"],
    "window": "PT5M",
    "threshold": 3,
    "severity": "medium",
    "suppress_for": "PT15M",
    "summary_template": "Recovery step {fields.step} of {service} failed {count} times within {window}"
  }
]
